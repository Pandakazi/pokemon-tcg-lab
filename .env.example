# Normal use: synchronized TCGdex SQLite database. Run python -m tcg_lab.sync_cards first.
# Tests can explicitly select snapshot. Legacy live mode calls TCGdex on each request.
TCG_CARD_SOURCE=sqlite
TCG_CARDS_DB_PATH=data/cards.sqlite3
# Relative paths are relative to the directory where you start the server.
TCG_DB_PATH=data/decks.sqlite3
TCG_PORT=8000
# This private version binds to 127.0.0.1 only. No OpenAI API key required.
